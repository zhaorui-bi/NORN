include LICENSE README.md CHANGELOG.md CONTRIBUTING.md CITATION.cff .pre-commit-config.yaml
include uv.lock .python-version
recursive-include configs *.json
recursive-include docs *.md *.png *.svg *.tex *.pdf
recursive-include scripts *.py *.sh
recursive-include tests *.py
recursive-include .github *.yml
include data/README.md
prune outputs
prune processed
prune data/external
prune .venv
