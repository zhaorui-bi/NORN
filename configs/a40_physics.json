{
  "schema_version": 1,
  "grid": {
    "nlat": 180,
    "nlon": 360
  },
  "model": {
    "width": 32,
    "blocks": 6,
    "lmax": 32,
    "mmax": 32,
    "backbone": "sfno",
    "head_mode": "absolute",
    "time_frequency_bands": 2,
    "ffn_multiplier": 2
  },
  "data": {
    "prepared": "../processed/gmt_dataset.npz",
    "observations": "../processed/observations.csv",
    "modern": "../../present_crustal_thickness.dat",
    "rotations": "../data/external/zahirovic2022/Rotations/Zahirovic_etal_2022_OptimisedMantleRef_and_NNRMantleRef.rot",
    "static_polygons": "../data/external/zahirovic2022/StaticPolygons/Global_EarthByte_GPlates_PresentDay_StaticPlatePolygons.shp",
    "continental_polygons": "../data/external/zahirovic2022/ContinentalPolygons/Global_EarthByte_GPlates_PresentDay_ContinentalPolygons.shp",
    "topologies": "../data/external/zahirovic2022/Topologies",
    "geometry_mode": "dynamic",
    "geometry_source": "gmt",
    "plate_gmt_dir": "../../古板块边界-时间间隔每百万年 - 最终版",
    "deformation_gmt_dir": "../../构造变形区边界-时间间隔每百万年 - 最终版",
    "coordinate_mode": "paleo",
    "source_semantics": "unverified_proxy",
    "holdout_csv": "../processed/challenge_test_set.csv",
    "validation_fraction": 0.1
  },
  "physics": {
    "constraints": "../processed/gmt_rigid_priors.npz",
    "trajectory_weight": 0.05,
    "budget_weight": 0.05
  },
  "training": {
    "steps": 500,
    "device": "cuda",
    "anchor_batch_size": 16,
    "learning_rate": 0.0005,
    "warmup_steps": 25,
    "checkpoint_every": 25,
    "validation_every": 10,
    "log_every": 10,
    "objective": "reconstruction",
    "selection_metric": "validation_mae",
    "observation_huber_weight": 0.0,
    "huber_beta_km": 5.0,
    "temporal_smooth_weight": 0.0
  },
  "max_age_ma": 60.0,
  "anchor_step_myr": 1.0,
  "output_dir": "../outputs/gmt_a40/physics"
}
