{
  "grid": {"nlat": 180, "nlon": 360},
  "model": {"backbone": "sfno", "width": 32, "blocks": 6, "lmax": 32, "mmax": 32},
  "data": {
    "prepared": "../processed/gmt_dataset.npz",
    "observations": "../data/observations.csv",
    "modern": "../data/modern.dat",
    "rotations": "../data/external/zahirovic2022/Rotations/Zahirovic_etal_2022_OptimisedMantleRef_and_NNRMantleRef.rot",
    "static_polygons": "../data/external/zahirovic2022/StaticPolygons/Global_EarthByte_GPlates_PresentDay_StaticPlatePolygons.shp",
    "continental_polygons": "../data/external/zahirovic2022/ContinentalPolygons/Global_EarthByte_GPlates_PresentDay_ContinentalPolygons.shp",
    "topologies": "../data/external/zahirovic2022/Topologies",
    "geometry_mode": "dynamic",
    "geometry_source": "gmt",
    "plate_gmt_dir": "../data/plate_gmt",
    "deformation_gmt_dir": "../data/deformation_gmt",
    "coordinate_mode": "paleo",
    "source_semantics": "unverified_proxy",
    "validation_fraction": 0.1
