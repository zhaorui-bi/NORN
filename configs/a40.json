{
  "schema_version": 1,
  "grid": {"nlat": 180, "nlon": 360},
  "model": {"width": 32, "blocks": 6, "lmax": 32, "mmax": 32},
  "data": {
    "prepared": "../processed/release_dataset.npz",
    "observations": "../processed/observations.csv",
    "modern": "../../present_crustal_thickness.dat",
    "rotations": "../data/external/muller2019/Rotations/Muller_etal_2019_CombinedRotations.rot",
    "static_polygons": "../data/external/muller2019/StaticPolygons/Muller_etal_2019_Global_StaticPlatePolygons.gpmlz",
    "coordinate_mode": "paleo",
    "source_semantics": "unverified_proxy",
    "holdout_csv": "../processed/challenge_test_set.csv",
    "validation_fraction": 0.1
  },
  "physics": {
    "constraints": "../processed/release_rigid_priors.npz",
    "trajectory_weight": 0.05,
    "budget_weight": 0.05
  },
  "training": {
    "steps": 500,
    "device": "cuda",
    "anchor_batch_size": 4,
    "learning_rate": 0.0005,
    "warmup_steps": 25,
    "checkpoint_every": 25,
    "validation_every": 10,
    "log_every": 10
  },
  "output_dir": "../outputs/release_a40"
}
